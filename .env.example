# ==============================================================================
# DevPilot Environment Configuration
# ==============================================================================

# LLM Configuration (OpenAI - Tiered Strategy)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_PLANNER=gpt-4o
OPENAI_MODEL_IMPLEMENTER=gpt-4o
OPENAI_MODEL_REVIEWER=gpt-4o-mini
OPENAI_MODEL_QA=gpt-4o-mini

# E2B Sandbox Configuration
E2B_API_KEY=your_e2b_api_key_here

# GitHub App Authentication (Minting short-lived installation tokens)
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./github_app_private_key.pem
GITHUB_APP_INSTALLATION_ID=789012

# Database & Checkpointer (PostgreSQL with pgvector)
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot_secret
POSTGRES_DB=devpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://devpilot:devpilot_secret@localhost:5432/devpilot

# Execution & Worker Policies (Decisions 12, 18, 19)
MAX_WORKERS_PARALLEL=5
MAX_QA_REPAIR_ATTEMPTS=3
WORKER_STEP_LIMIT=20
WORKER_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=INFO
